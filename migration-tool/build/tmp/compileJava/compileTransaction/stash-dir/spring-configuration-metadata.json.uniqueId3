{
  "groups": [
    {
      "name": "migration",
      "type": "com.common.migration.config.MigrationProperties",
      "sourceType": "com.common.migration.config.MigrationProperties"
    },
    {
      "name": "migration.oracle",
      "type": "com.common.migration.config.MigrationProperties$Db",
      "sourceType": "com.common.migration.config.MigrationProperties",
      "sourceMethod": "getOracle()"
    },
    {
      "name": "migration.postgres",
      "type": "com.common.migration.config.MigrationProperties$Db",
      "sourceType": "com.common.migration.config.MigrationProperties",
      "sourceMethod": "getPostgres()"
    }
  ],
  "properties": [
    {
      "name": "migration.batch-size",
      "type": "java.lang.Integer",
      "sourceType": "com.common.migration.config.MigrationProperties",
      "defaultValue": 1000
    },
    {
      "name": "migration.exclude-tables",
      "type": "java.util.List<java.lang.String>",
      "description": "이관하지 않을 Oracle 테이블",
      "sourceType": "com.common.migration.config.MigrationProperties"
    },
    {
      "name": "migration.fetch-size",
      "type": "java.lang.Integer",
      "sourceType": "com.common.migration.config.MigrationProperties",
      "defaultValue": 1000
    },
    {
      "name": "migration.key-columns",
      "type": "java.util.Map<java.lang.String,java.util.List<java.lang.String>>",
      "description": "Oracle 에 PK 가 없는 테이블의 비교 키 (Oracle 테이블명 → Oracle 컬럼명 목록)",
      "sourceType": "com.common.migration.config.MigrationProperties"
    },
    {
      "name": "migration.oracle.password",
      "type": "java.lang.String",
      "sourceType": "com.common.migration.config.MigrationProperties$Db"
    },
    {
      "name": "migration.oracle.schema",
      "type": "java.lang.String",
      "sourceType": "com.common.migration.config.MigrationProperties$Db"
    },
    {
      "name": "migration.oracle.url",
      "type": "java.lang.String",
      "sourceType": "com.common.migration.config.MigrationProperties$Db"
    },
    {
      "name": "migration.oracle.username",
      "type": "java.lang.String",
      "sourceType": "com.common.migration.config.MigrationProperties$Db"
    },
    {
      "name": "migration.postgres.password",
      "type": "java.lang.String",
      "sourceType": "com.common.migration.config.MigrationProperties$Db"
    },
    {
      "name": "migration.postgres.schema",
      "type": "java.lang.String",
      "sourceType": "com.common.migration.config.MigrationProperties$Db"
    },
    {
      "name": "migration.postgres.url",
      "type": "java.lang.String",
      "sourceType": "com.common.migration.config.MigrationProperties$Db"
    },
    {
      "name": "migration.postgres.username",
      "type": "java.lang.String",
      "sourceType": "com.common.migration.config.MigrationProperties$Db"
    },
    {
      "name": "migration.source-charset",
      "type": "java.lang.String",
      "description": "Oracle 에 저장된 한글 바이트 문자셋",
      "sourceType": "com.common.migration.config.MigrationProperties",
      "defaultValue": "MS949"
    },
    {
      "name": "migration.table-map",
      "type": "java.util.Map<java.lang.String,java.lang.String>",
      "description": "Oracle 테이블명(대문자) → PostgreSQL 테이블명",
      "sourceType": "com.common.migration.config.MigrationProperties"
    }
  ],
  "hints": []
}